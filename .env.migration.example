# Copy to .env.migration and fill in (never commit .env.migration)

# --- Old Lovable Cloud project (source) ---
SOURCE_SUPABASE_URL=https://agmawqmymdpcrcelxuzc.supabase.co
# Required for private buckets (pdp-submissions, service-hours-photos, etc.)
# Get via Lovable edge function env or Cloud export tooling — not the anon key.
SOURCE_SERVICE_ROLE_KEY=

# --- New Supabase project (target) ---
TARGET_SUPABASE_PROJECT_ID=fdgdkhnvalrwarcedzml
TARGET_SUPABASE_URL=https://fdgdkhnvalrwarcedzml.supabase.co
TARGET_SERVICE_ROLE_KEY=

# Database password from Dashboard → Project Settings → Database
TARGET_DB_PASSWORD=
# Or full connection string:
# TARGET_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.fdgdkhnvalrwarcedzml.supabase.co:5432/postgres?sslmode=require

# Path to unzipped .backup file (inside the Lovable export zip)
BACKUP_PATH=/tmp/chapter-harmony-hub.backup

# Optional: if pg_restore is not on PATH
# PG_RESTORE_PATH=/opt/homebrew/opt/postgresql@17/bin/pg_restore
